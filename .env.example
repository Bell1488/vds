# Server
PORT=8080

# Yandex Metrika numeric counter ID. Injected into all HTML responses automatically.
YANDEX_METRIKA_ID=

# SOCKS5 proxy for Telegram API (required in Russia)
# Format: socks5h://host:port or socks5h://user:pass@host:port
# Example: socks5h://127.0.0.1:1080
SOCKS5_PROXY=

# Lead delivery: configure at least one destination.
# Generic CRM / Make / n8n / Bitrix webhook:
LEAD_WEBHOOK_URL=

# Telegram lead delivery (optional alternative or second destination):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
